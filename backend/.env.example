# Copy to .env and adjust. Never commit the real .env.
#
# Note: scripts/devdb.py writes .env.local, which takes precedence over this
# file — so the no-Docker local setup needs no manual edits here.

# --- Database ---------------------------------------------------------
# Docker Compose default (see docker-compose.yml at the repo root):
DATABASE_URL=postgresql+asyncpg://pgms:pgms@localhost:5432/pgms

# --- Auth -------------------------------------------------------------
# Generate a real one for anything but local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App --------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
